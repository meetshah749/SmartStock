# SmartStock AI - Environment Configuration Example

# System & Environment
PROJECT_NAME="SmartStock AI"
ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production-super-secret-key-32bytes-min!
DEBUG=True
API_V1_STR=/api/v1

# Frontend URL & CORS
FRONTEND_URL=http://localhost:3000
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=smartstock_db
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}

# Cache & Background Jobs (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/0

# Market Data Provider (TrueData Official Integration)
# Official TrueData credentials for Indian Market Data (NSE / BSE)
TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=
TRUEDATA_URL=https://history.truedata.in
TRUEDATA_WS_URL=wss://ws.truedata.in
TRUEDATA_PORT=8082
MARKET_DATA_PROVIDER=truedata  # Options: truedata, benchmark_fixture

# SMTP Email Delivery (Leave blank for development verification mode)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=noreply@smartstock.com

# JWT Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Initial Virtual Trading Wallet Config
DEFAULT_VIRTUAL_BALANCE_PAISE=50000  # ₹500.00 in integer paise
